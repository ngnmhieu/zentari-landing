---
/* Wraps content that is not yet true. Marked visibly on purpose: a
   placeholder that looks finished is the one that ships by accident.
   Delete the wrapper once the content behind it is real. */
interface Props {
  note: string;
  /** 'dark' for placement on a dark band. The blue marking cannot reach AA
      on the hero's wash — no shade of it can — so that tone goes white. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { note, tone = 'light', class: extra = '' } = Astro.props;

const tones = {
  light: { frame: 'border-primary/45', note: 'text-primary' },
  dark: { frame: 'border-white/55', note: 'text-white' },
} as const;

const { frame, note: noteColour } = tones[tone];
---

<div class={`rounded-edge border border-dashed ${frame} p-5 ${extra}`}>
  <p class={`mb-4 text-micro ${noteColour}`}>Placeholder — {note}</p>
  <slot />
</div>
