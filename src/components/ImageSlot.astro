---
/* Holds the place of a photograph the layout carries here. Deliberately
   obvious rather than a grey rectangle that could pass for finished design.
   Replace with <Image> from astro:assets once there is real photography;
   keep the aspect ratio so the grid does not reflow when you do. */
interface Props {
  ratio?: string;
  label: string;
  class?: string;
}

const { ratio = '4 / 3', label, class: extra = '' } = Astro.props;
---

<div
  class={`flex items-center justify-center rounded-edge border border-dashed border-accent-text/45 bg-shell p-4 ${extra}`}
  style={`aspect-ratio: ${ratio}`}
  role="img"
  aria-label={`Placeholder for ${label}`}
>
  <span class="text-center text-micro text-accent-text">Photo needed — {label}</span>
</div>
