---
import { contact, nav, services, site } from '../data/site';

const year = new Date().getFullYear();
const hasContact = Boolean(contact.email || contact.phone || contact.street);
---

<footer class="bg-ink text-white/70">
  <div class="mx-auto w-full max-w-shell px-gutter py-band">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <p class="text-h5 font-medium text-white">{site.name}</p>
        <p class="mt-3 max-w-[34ch] text-small">{site.tagline}.</p>
      </div>

      <div>
        <h2 class="text-label font-medium text-white">Services</h2>
        <ul class="mt-4 list-none space-y-2.5 p-0">
          {
            services.map((service) => (
              <li>
                <a class="text-small no-underline transition-colors hover:text-white" href="#services">
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-label font-medium text-white">Company</h2>
        <ul class="mt-4 list-none space-y-2.5 p-0">
          {
            nav.map((item) => (
              <li>
                <a class="text-small no-underline transition-colors hover:text-white" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-label font-medium text-white">Contact</h2>
        {
          hasContact ? (
            <ul class="mt-4 list-none space-y-2.5 p-0 text-small">
              {contact.street && <li>{contact.street}</li>}
              {contact.city && <li>{contact.city}</li>}
              {contact.phone && (
                <li>
                  <a class="no-underline hover:text-white" href={contact.phoneHref}>
                    {contact.phone}
                  </a>
                </li>
              )}
              {contact.email && (
                <li>
                  <a class="no-underline hover:text-white" href={`mailto:${contact.email}`}>
                    {contact.email}
                  </a>
                </li>
              )}
            </ul>
          ) : (
            <p class="mt-4 text-micro text-primary-light">
              Placeholder — add the address, phone and inbox in src/data/site.ts x
            </p>
          )
        }
      </div>
    </div>

    <p class="mt-14 border-t border-white/15 pt-7 text-micro">&copy; {year} {site.name}</p>
  </div>
</footer>
