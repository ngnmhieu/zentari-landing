---
import Nav from '../components/Nav.tsx';
import Footer from '../components/Footer.astro';
import { contact, site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  /** Omitted when empty: a blank description meta is worse than none. */
  description?: string;
  standaloneTitle?: boolean;
}

const { title, description, standaloneTitle = false } = Astro.props;

const pageTitle = standaloneTitle ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

// Search engines read this as fact, so only fields with a real value go in.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: site.tagline,
  url: site.url,
  ...(contact.email ? { email: contact.email } : {}),
  ...(contact.phoneHref ? { telephone: contact.phoneHref.replace('tel:', '') } : {}),
};
---

<!doctype html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <link rel="icon" href="/favicon/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <noscript>
      <style>
        /* Without JavaScript the island never hydrates, so the menu button
           cannot open anything. Show the links and hide the button instead. */
        #site-nav {
          display: flex !important;
        }
        [aria-controls='site-nav'] {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="bg-white font-sans text-body leading-[1.4] text-body antialiased">
    <a
      class="absolute top-0 left-2 z-100 rounded-edge bg-accent px-4 py-2.5 text-ink no-underline transition-transform focus:translate-y-2 -translate-y-24"
      href="#content">Skip to content</a
    >
    {/* Fixed rather than sticky, so the hero photograph runs up behind it and
        the bar can start out transparent. The hero pays for that with matching
        top padding; any future page whose first band is light will need a dark
        one of its own, or this bar's white type will vanish into it. */}
    <header
      class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-200 data-[scrolled]:border-white/10 data-[scrolled]:bg-ink/95 data-[scrolled]:backdrop-blur data-[menu-open]:border-white/10 data-[menu-open]:bg-ink/95"
    >
      <div
        class="relative mx-auto flex min-h-18 w-full max-w-shell items-center justify-between gap-6 px-gutter"
      >
        <a class="flex items-center no-underline" href="/">
          <img
            src="/img/logo-small.png"
            alt={site.name}
            width="451"
            height="100"
            class="h-7 w-auto"
          />
        </a>
        <Nav client:load />
      </div>
    </header>
    {/* Inline and immediately after the bar, so a page opened part-way down
        paints with the background already on instead of flashing clear. */}
    <script is:inline>
      (() => {
        const header = document.querySelector('header');
        const sync = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
        sync();
        addEventListener('scroll', sync, { passive: true });
      })();
    </script>
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
